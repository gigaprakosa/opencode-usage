#!/usr/bin/env python3
"""opencode-usage — local "last 2 months" token & cost report for opencode.

Reads opencode's local SQLite store (~/.local/share/opencode/opencode.db),
sums per-message token usage by month, and prices every model with live data
fetched fresh from models.dev on every run.

Models that models.dev prices at $0 (flat-rate subscription plans) are
automatically valued at the equivalent pay-as-you-go API rate for the same
model id — so cost reflects real dollars, with no provider/model hardcoding.

Zero external dependencies — Python 3 standard library only.
Output:
    📊 OpenCode Usage (last 2 months):
    • 2026-05: 12,345,678 tokens, Cost: $4.20
    • 2026-06: 98,765,432 tokens, Cost: $31.50
"""

from __future__ import annotations

import argparse
import itertools
import json
import sqlite3
import sys
import threading
import time
import urllib.error
import urllib.request
from collections import defaultdict
from datetime import datetime
from pathlib import Path

HOME = Path.home()


# ---------------------------------------------------------------------------
# Paths & constants
# ---------------------------------------------------------------------------
class Paths:
    DB = HOME / ".local/share/opencode/opencode.db"
    PRICING_CACHE = HOME / ".cache/opencode-usage/models-dev.json"


MODELS_DEV_URL = "https://models.dev/api.json"
HTTP_TIMEOUT = 15  # seconds
MONTHS_BACK = 2    # report window: current + previous calendar month


# ---------------------------------------------------------------------------
# Loading UI — lightweight stderr spinner (tty only, stdlib threading)
# ---------------------------------------------------------------------------
class Spinner:
    """Animated stderr status while slow work runs (e.g. the models.dev fetch).

    Renders to stderr only — stdout stays clean for piping. No-op unless stderr
    is a real terminal, so redirected output never gets frames.
    """

    FRAMES = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
    INTERVAL = 0.08  # seconds per frame

    def __init__(self, message: str):
        self.message = message
        self.enabled = sys.stderr.isatty()
        self._stop = threading.Event()
        self._thread = None

    def __enter__(self):
        if self.enabled:
            self._thread = threading.Thread(target=self._spin, daemon=True)
            self._thread.start()
        return self

    def __exit__(self, *exc):
        if self._thread is not None:
            self._stop.set()
            self._thread.join()
            sys.stderr.write("\r\033[K")  # erase the spinner line
            sys.stderr.flush()
        return False

    def _spin(self):
        for frame in itertools.cycle(self.FRAMES):
            if self._stop.is_set():
                return
            sys.stderr.write(f"\r{frame} {self.message}…")
            sys.stderr.flush()
            time.sleep(self.INTERVAL)


# ---------------------------------------------------------------------------
# Data access — read opencode's SQLite store (read-only)
# ---------------------------------------------------------------------------
class OpencodeDB:
    """Read-only accessor for opencode's local message store."""

    def __init__(self, db_path: Path):
        self.db_path = Path(db_path)
        if not self.db_path.exists():
            raise FileNotFoundError(f"opencode database not found: {self.db_path}")
        # mode=ro guarantees we never write or lock the live DB.
        uri = f"file:{self.db_path}?mode=ro"
        self.con = sqlite3.connect(uri, uri=True)
        self.con.row_factory = sqlite3.Row

    def close(self) -> None:
        try:
            self.con.close()
        except Exception:
            pass

    def assistant_messages(self):
        """Yield one normalized record per assistant message.

        Token fields and model identity come from the JSON `data` column via
        json_extract, so we rely on the same numbers opencode itself persisted.
        """
        sql = """
            SELECT
                time_created,
                json_extract(data, '$.providerID')                       AS provider,
                json_extract(data, '$.modelID')                          AS model,
                COALESCE(json_extract(data, '$.tokens.input'), 0)        AS input,
                COALESCE(json_extract(data, '$.tokens.output'), 0)       AS output,
                COALESCE(json_extract(data, '$.tokens.reasoning'), 0)    AS reasoning,
                COALESCE(json_extract(data, '$.tokens.cache.read'), 0)   AS cache_read,
                COALESCE(json_extract(data, '$.tokens.cache.write'), 0)  AS cache_write,
                json_extract(data, '$.time.created')                     AS ts_created
            FROM message
            WHERE json_extract(data, '$.role') = 'assistant'
        """
        for row in self.con.execute(sql):
            ts_ms = row["ts_created"] or row["time_created"]
            yield {
                "ts_ms": int(ts_ms),
                "provider": row["provider"] or "unknown",
                "model": row["model"] or "unknown",
                "input": int(row["input"] or 0),
                "output": int(row["output"] or 0),
                "reasoning": int(row["reasoning"] or 0),
                "cache_read": int(row["cache_read"] or 0),
                "cache_write": int(row["cache_write"] or 0),
            }


# ---------------------------------------------------------------------------
# Pricing — fresh models.dev fetch every run, with generic real-price resolution
# ---------------------------------------------------------------------------
RATE_KEYS = ("input", "output", "cache_read", "cache_write")


def _has_rate(cost: dict) -> bool:
    """True when a models.dev cost dict carries any non-zero per-token rate."""
    return bool(cost) and any((cost.get(k) or 0) > 0 for k in RATE_KEYS)


def _twin_provider(provider: str):
    """Pay-as-you-go twin of a subscription/plan provider.

    Recursively strips common plan/region suffixes until none match. Returns
    the stripped form (which may not itself exist as a provider, in which case
    callers fall through to the median cross-provider index), or None if the
    input carried no plan/region suffix at all.

      'zai-coding-plan'       -> 'zai'
      'alibaba-token-plan-cn' -> 'alibaba-token'  (may not exist; median fallback)
      'anthropic'             -> None
    """
    original = provider
    while True:
        for suffix in ("-coding-plan", "-token-plan", "-plan", "-cn"):
            if provider.endswith(suffix):
                provider = provider[:-len(suffix)]
                break
        else:
            break
    return provider if provider != original else None


class PricingEngine:
    """USD pricing using models.dev (opencode's own pricing source).

    Rates are USD per 1,000,000 tokens. A model that models.dev prices at $0
    (a flat-rate subscription plan) is resolved in three tiers:

      1. The source provider's own rate (happy path — usually already nonzero).
      2. The twin provider: source with plan/region suffixes stripped
         (e.g. ``zai-coding-plan`` -> ``zai``).
      3. The median output rate across all paid providers serving the same
         model id. Median (not max) ignores outlier listings.
    """

    def __init__(self):
        self.stale = False  # True when we fell back to the on-disk cache
        self.data = self._load()
        self._by_model = self._index_real_rates(self.data)

    # --- loading -----------------------------------------------------------
    def _load(self) -> dict:
        # ALWAYS attempt a fresh fetch first so pricing is current every run.
        try:
            req = urllib.request.Request(
                MODELS_DEV_URL, headers={"User-Agent": "opencode-usage"}
            )
            with urllib.request.urlopen(req, timeout=HTTP_TIMEOUT) as resp:
                raw = resp.read()
            data = json.loads(raw)
            self._write_cache(raw)
            return data
        except (urllib.error.URLError, TimeoutError, json.JSONDecodeError, OSError):
            # Live fetch failed — fall back to cache if we have one.
            self.stale = True
            if Paths.PRICING_CACHE.exists():
                try:
                    return json.loads(Paths.PRICING_CACHE.read_text())
                except (json.JSONDecodeError, OSError):
                    pass
            return {}

    @staticmethod
    def _write_cache(raw: bytes) -> None:
        try:
            Paths.PRICING_CACHE.parent.mkdir(parents=True, exist_ok=True)
            Paths.PRICING_CACHE.write_bytes(raw)
        except OSError:
            pass  # caching is best-effort, never fatal

    @staticmethod
    def _index_real_rates(data: dict) -> dict:
        """model_id -> representative non-zero cost dict across all providers.

        Picks the cost dict whose output rate is nearest the median output rate
        across all paid providers serving that model id. Median (not max) so a
        single outlier listing (e.g. a provider charging 5x market) doesn't
        dominate the fallback. Tie-break: lower input rate.
        """
        by_model: dict = defaultdict(list)
        for prov, pdata in data.items():
            for model_id, m in (pdata.get("models") or {}).items():
                cost = m.get("cost") or {}
                if _has_rate(cost):
                    by_model[model_id].append(cost)
        best: dict = {}
        for model_id, costs in by_model.items():
            if len(costs) == 1:
                best[model_id] = costs[0]
                continue
            outputs = sorted((c.get("output") or 0) for c in costs)
            median_out = outputs[len(outputs) // 2]
            best[model_id] = min(
                costs,
                key=lambda c: (
                    abs((c.get("output") or 0) - median_out),
                    c.get("input") or 0,
                ),
            )
        return best

    # --- resolution --------------------------------------------------------
    def _rate(self, provider: str, model: str):
        # 1. Source provider's own rate (happy path — usually nonzero already).
        node = self.data.get(provider) or {}
        own = (node.get("models", {}).get(model) or {}).get("cost") or {}
        if _has_rate(own):
            return own
        # 2. Twin provider: pay-as-you-go sibling of a subscription plan
        #    (e.g. zai-coding-plan -> zai). Models.dev lists both tiers with
        #    identical model ids, so the twin is the natural real-price proxy.
        twin = _twin_provider(provider)
        if twin and twin != provider:
            tnode = self.data.get(twin) or {}
            town = (tnode.get("models", {}).get(model) or {}).get("cost") or {}
            if _has_rate(town):
                return town
        # 3. Cross-provider fallback: representative median rate for this model id.
        return self._by_model.get(model)

    def cost(self, provider: str, model: str, tok: dict):
        """USD cost for one usage record. Returns (usd, priced_bool).

        Matches opencode's native formula
        (``packages/opencode/src/session/session.ts``):

            (input*in + output*out + reasoning*out
             + cache_read*cr + cache_write*cw) / 1e6

        Reasoning tokens are charged at the output rate because models.dev
        has no dedicated reasoning rate yet (upstream TODO in opencode source).
        """
        rate = self._rate(provider, model)
        if rate is None:
            return 0.0, False
        out_rate = rate.get("output") or 0
        usd = (
            tok["input"] * (rate.get("input") or 0)
            + tok["output"] * out_rate
            + tok["reasoning"] * out_rate  # opencode: reasoning priced as output
            + tok["cache_read"] * (rate.get("cache_read") or 0)
            + tok["cache_write"] * (rate.get("cache_write") or 0)
        ) / 1_000_000
        return usd, True


# ---------------------------------------------------------------------------
# Aggregation — tokens & cost per month
# ---------------------------------------------------------------------------
TOKEN_KEYS = ("input", "output", "cache_write", "cache_read", "reasoning")


def _month(ts_ms: int) -> str:
    return datetime.fromtimestamp(ts_ms / 1000).strftime("%Y-%m")


def _window_start_ms() -> int:
    """Unix ms at local midnight on the first day of the (MONTHS_BACK-1)th
    previous calendar month — i.e. the start of the report window."""
    now = datetime.now()
    month_index = now.year * 12 + (now.month - 1) - (MONTHS_BACK - 1)
    year, month0 = divmod(month_index, 12)
    start = datetime(year, month0 + 1, 1)
    return int(start.timestamp() * 1000)


def aggregate_by_month(records, pricing: PricingEngine) -> dict:
    """month 'YYYY-MM' -> {'tokens': int, 'cost': float}."""
    buckets = defaultdict(lambda: {"tokens": 0, "cost": 0.0})
    for r in records:
        b = buckets[_month(r["ts_ms"])]
        b["tokens"] += sum(r[k] for k in TOKEN_KEYS)
        usd, _ = pricing.cost(r["provider"], r["model"], r)
        b["cost"] += usd
    return buckets


# ---------------------------------------------------------------------------
# Rendering
# ---------------------------------------------------------------------------
def render(buckets: dict) -> str:
    out = ["📊 OpenCode Usage (last 2 months):"]
    if not buckets:
        out.append("• no usage in the last 2 months")
        return "\n".join(out)
    for month in sorted(buckets):
        b = buckets[month]
        out.append(f"• {month}: {b['tokens']:,} tokens, Cost: ${b['cost']:,.2f}")
    return "\n".join(out)


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------
def build_parser() -> argparse.ArgumentParser:
    return argparse.ArgumentParser(
        prog="opencode-usage",
        description="opencode token & cost report for the last 2 months "
                    "(reads ~/.local/share/opencode/opencode.db).",
    )


def main(argv=None) -> int:
    build_parser().parse_args(argv)  # only -h/--help; rejects stray args

    try:
        db = OpencodeDB(Paths.DB)
    except FileNotFoundError as e:
        print(f"error: {e}", file=sys.stderr)
        return 1

    try:
        with Spinner("reading opencode database"):
            records = list(db.assistant_messages())
    finally:
        db.close()

    start = _window_start_ms()
    records = [r for r in records if r["ts_ms"] >= start]

    with Spinner("fetching pricing from models.dev"):
        pricing = PricingEngine()

    buckets = aggregate_by_month(records, pricing)
    print(render(buckets))
    if pricing.stale:
        print("⚠ pricing is STALE (live models.dev fetch failed; using cached prices)",
              file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
